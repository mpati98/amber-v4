# Chỉ ghi TÊN biến — giá trị thật đặt trong .env (local) hoặc Vercel → Environment Variables.

# Postgres (Neon). Production nên dùng host "-pooler".
DATABASE_URL=
# Khoá NextAuth; cũng là khoá HMAC để hash IP ở form liên hệ công khai.
AUTH_SECRET=
# Khoá ký access token cho app Flutter.
MOBILE_JWT_SECRET=
# Groq (chat, Whisper, TTS).
GROQ_API_KEY=
# Vercel Blob (upload Tàng Kinh Các).
BLOB_READ_WRITE_TOKEN=
# Origin của app Flutter web cho CORS.
MOBILE_APP_ORIGIN=
# Chỉ khi tự host (next start ngoài Vercel): true.
AUTH_TRUST_HOST=

# --- Form liên hệ công khai (POST /api/public/contact) ---
# Hộp thư nhận email báo tin nhắn mới.
CONTACT_NOTIFY_EMAIL=
# Origin của portfolio được phép gọi (CORS), vd https://duangmai.io.vn. Thiếu thì không có CORS.
PORTFOLIO_ORIGIN=
# Khoá API Resend để gửi email báo tin. Thiếu thì vẫn lưu tin nhắn, chỉ bỏ qua email.
RESEND_API_KEY=
